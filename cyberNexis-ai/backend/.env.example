# =====================================================================
# Sentinel AI - Telegram & Email Alert Configuration
# =====================================================================

# ── Telegram Bot Alerts ───────────────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Start a conversation with your bot or add it to a channel/group
# 3. Message @userinfobot or @raw_data_bot on Telegram to get your TELEGRAM_CHAT_ID
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email (SMTP) Security Alerts ──────────────────────────────────────
# For Gmail: Use an "App Password" generated in your Google Account Security settings
# (requires 2-Step Verification enabled on Google).
EMAIL_ALERTS_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
ALERT_RECIPIENT_EMAIL=security-alerts@yourcompany.com
